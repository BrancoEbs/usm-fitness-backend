# Copiar como .env y completar. Nunca subir .env al repositorio.

# --- Núcleo ---
DJANGO_DEBUG=False
# Generar con: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=gimnasio.usm.cl

# --- Orígenes permitidos (frontend) ---
CORS_ALLOWED_ORIGINS=https://gimnasio.usm.cl
CSRF_TRUSTED_ORIGINS=https://gimnasio.usm.cl

# --- Base de datos PostgreSQL (si se omite DB_NAME se usa SQLite) ---
DB_NAME=gimnasio_usm
DB_USER=gimnasio
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Archivos ---
DJANGO_STATIC_ROOT=/srv/gimnasio/backend/staticfiles
DJANGO_MEDIA_ROOT=/srv/gimnasio/backend/media
TAMANO_MAXIMO_PDF_MB=10

# --- Registro ---
DOMINIOS_CORREO_PERMITIDOS=usm.cl,sansano.usm.cl

# --- Tokens JWT ---
JWT_ACCESS_MINUTOS=30
JWT_REFRESH_DIAS=7

# --- Límites de solicitudes ---
THROTTLE_LOGIN=10/min
THROTTLE_REGISTRO=5/hour
# Proxies delante de Django (Nginx = 1)
NUM_PROXIES=1

# --- Documentación Swagger (solo activar si es necesario) ---
SWAGGER_ENABLED=False
